{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sdlc-timeline-builder",
  "main": "src/worker.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "tlb.web.id",
      "custom_domain": true
    },
    {
      "pattern": "www.tlb.web.id",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "SDLC_TIMELINE_STORAGE",
      "id": "e1718b679f5f4135a19b96263aacc82a"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sdlc-timeline-db",
      "database_id": "8c453481-cdce-475f-a153-97bad1a9caaf"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TIMELINE_ROOM",
        "class_name": "TimelineRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TimelineRoom"]
    }
  ]
}
